# === DocLens Environment Variables ===

# Groq API (required — get key at console.groq.com)
GROQ_API_KEY=gsk_your_key_here

# PostgreSQL
POSTGRES_USER=doclens
POSTGRES_PASSWORD=doclens_secret
POSTGRES_DB=doclens
DATABASE_URL=postgresql+asyncpg://doclens:doclens_secret@postgres:5432/doclens

# Redis
REDIS_URL=redis://redis:6379/0

# JWT Auth
JWT_SECRET_KEY=change-this-to-a-random-string-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# Backend
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
MAX_UPLOAD_SIZE_MB=20

# LLM Config
LLM_PRIMARY_MODEL=llama-3.3-70b-versatile
LLM_FALLBACK_MODEL=llama-3.1-8b-instant
MAX_CONTEXT_TOKENS=2000
MAX_COMPLETION_TOKENS=512
RELEVANCE_THRESHOLD=0.05
